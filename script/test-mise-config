#!/bin/bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT
mise_data="$(cat "$repo_root/root/.chezmoidata.yaml")"

assert_contains() {
  local value="$1"
  local expected="$2"

  if [[ "$value" != *"$expected"* ]]; then
    echo "Expected output to contain: $expected" >&2
    echo "$value" >&2
    exit 1
  fi
}

assert_not_contains() {
  local value="$1"
  local unexpected="$2"

  if [[ "$value" == *"$unexpected"* ]]; then
    echo "Expected output not to contain: $unexpected" >&2
    echo "$value" >&2
    exit 1
  fi
}

install_templates=("$repo_root"/root/run_onchange_after_*_mise_install.sh.tmpl)
if [ "${#install_templates[@]}" -ne 1 ] || [ ! -f "${install_templates[0]}" ]; then
  echo "Expected exactly one mise install hook" >&2
  exit 1
fi
install_template="${install_templates[0]}"
install_target="${install_template##*/}"
install_target="${install_target#run_onchange_after_}"
install_target="${install_target%.tmpl}"
for setup_template in "$repo_root"/root/run_once_after_01_{configuration,go_environment}.sh.tmpl; do
  setup_target="${setup_template##*/}"
  setup_target="${setup_target#run_once_after_}"
  setup_target="${setup_target%.tmpl}"
  first_target="$(printf '%s\n' "$install_target" "$setup_target" | LC_ALL=C sort | head -n 1)"
  if [ "$first_target" != "$install_target" ]; then
    echo "Mise installation must run before $setup_target" >&2
    exit 1
  fi
done
apm_target="03_apm_skills"
first_target="$(printf '%s\n' "$install_target" "$apm_target" | LC_ALL=C sort | head -n 1)"
if [ "$first_target" != "$install_target" ]; then
  echo "Mise installation must run before APM skills" >&2
  exit 1
fi

render_config() {
  local config
  local profile="${5:-work}"
  config="$(
    DEVCONTAINER="$4" MISE_DISTRO_CODENAME=jammy \
      chezmoi --source "$repo_root" \
        --override-data "{\"chezmoi\":{\"os\":\"$1\"},\"codespaces\":$2,\"repo\":\"$3\",\"machine\":{\"profile\":\"$profile\"}}" \
        execute-template < "$repo_root/root/private_dot_config/mise/private_config.toml.tmpl"
  )" || return
  printf '%s\n' "$config" > "$tmp_dir/config.toml"
  MISE_CONFIG_DIR="$tmp_dir" mise --cd "$tmp_dir" config ls >/dev/null || return
  printf '%s\n' "$config"
}

local_config="$(render_config darwin false "" false)"
assert_contains "$local_config" 'lockfile = true'
assert_contains "$local_config" 'minimum_release_age = "7d"'
assert_not_contains "$local_config" 'minimum_release_age_excludes'
assert_contains "$local_config" $'[tools."npm:@github/copilot"]\nversion = "latest"\nminimum_release_age = "0s"'
assert_contains "$local_config" '[settings.status]'
assert_contains "$local_config" 'missing_tools = "never"'
assert_contains "$local_config" '"github:golangci/golangci-lint" = "latest"'
assert_contains "$local_config" $'[tools."apm"]\nversion = "latest"\nasset_pattern = "apm-{{ os(macos=\\\"darwin\\\") }}-{{ arch(x64=\\\"x86_64\\\", arm64=\\\"arm64\\\") }}.tar.gz"'
assert_not_contains "$local_config" '"npm:rosie-skills"'
assert_contains "$local_config" '"npm:wgc" = "latest"'
assert_contains "$local_config" '"github:github/feature-flags-mcp-server" = "latest"'
assert_contains "$local_config" '"python" = "latest"'
assert_contains "$local_config" '"direnv" = "latest"'
assert_contains "$local_config" '"rust" = "latest"'

personal_config="$(render_config darwin false "" false personal)"
assert_not_contains "$personal_config" '"npm:wgc"'
assert_not_contains "$personal_config" '"github:github/feature-flags-mcp-server"'
assert_not_contains "$personal_config" '"python" = "latest"'
assert_not_contains "$personal_config" '"direnv" = "latest"'
assert_not_contains "$personal_config" '"rust" = "latest"'

linux_config="$(render_config linux false "" false)"
assert_contains "$linux_config" 'minimum_release_age = "7d"'
assert_contains "$linux_config" $'[tools."apm"]\nversion = "latest"\nasset_pattern = "apm-{{ os(macos=\\\"darwin\\\") }}-{{ arch(x64=\\\"x86_64\\\", arm64=\\\"arm64\\\") }}.tar.gz"'
assert_not_contains "$linux_config" '"npm:rosie-skills"'
assert_not_contains "$linux_config" '[tools."npm:@github/copilot"]'
assert_not_contains "$linux_config" '"github:golangci/golangci-lint"'
assert_not_contains "$linux_config" '"gh" = "latest"'
assert_not_contains "$linux_config" '"npm:wgc"'

codespace_config="$(render_config linux true github/github false)"
assert_contains "$codespace_config" 'minimum_release_age = "7d"'
assert_not_contains "$codespace_config" 'minimum_release_age_excludes'
assert_contains "$codespace_config" $'[tools."npm:@github/copilot"]\nversion = "latest"\nminimum_release_age = "0s"'
assert_not_contains "$codespace_config" '"github:golangci/golangci-lint"'
assert_contains "$codespace_config" '"gh" = "latest"'
assert_not_contains "$codespace_config" '"npm:wgc"'

devcontainer_config="$(render_config linux false github/github true)"
assert_contains "$devcontainer_config" 'minimum_release_age = "7d"'
assert_not_contains "$devcontainer_config" '[tools."npm:@github/copilot"]'
assert_not_contains "$devcontainer_config" '"github:golangci/golangci-lint"'
assert_contains "$devcontainer_config" '"gh" = "latest"'
assert_not_contains "$devcontainer_config" '"npm:wgc"'

personal_linux_config="$(render_config linux false "" false personal)"
for config in "$local_config" "$personal_config" "$linux_config" "$codespace_config" "$devcontainer_config" "$personal_linux_config"; do
  assert_contains "$config" 'min_version = "2026.8.16"'
  assert_contains "$config" 'idiomatic_version_file_enable_tools = ["node", "rust"]'
  assert_contains "$config" '"mr-boxington" = "latest"'
  assert_not_contains "$config" '[tools."mr-boxington"]'
  assert_contains "$config" '[wrappers.cargo]'
  assert_contains "$config" 'command = "mbx"'
  assert_contains "$config" 'MBX_CARGO_SHIM_MODE = "1"'
  assert_not_contains "$config" 'mbx setup'
done

render_custom_config() {
  local profile="$1"
  local tools="$2"
  DEVCONTAINER=false MISE_DISTRO_CODENAME=jammy \
    chezmoi --source "$repo_root" \
      --override-data "{\"chezmoi\":{\"os\":\"darwin\"},\"codespaces\":false,\"repo\":\"\",\"machine\":{\"profile\":\"$profile\"},\"mise_tools\":$tools}" \
      execute-template < "$repo_root/root/private_dot_config/mise/private_config.toml.tmpl"
}

profiled_tools='[{"name":"work-alias","alias":"github:example/work-alias","filters":{"profile":["work"]}},{"name":"work-variant","variants":[{"options":{"feature_enabled":true},"filters":{"profile":["work"]}}]}]'
work_profiled_config="$(render_custom_config work "$profiled_tools")"
personal_profiled_config="$(render_custom_config personal "$profiled_tools")"
assert_contains "$work_profiled_config" '"work-alias" = "github:example/work-alias"'
assert_contains "$work_profiled_config" '"work-alias" = "latest"'
assert_contains "$work_profiled_config" $'[tools."work-variant"]\nversion = "latest"\nfeature_enabled = true'
assert_not_contains "$personal_profiled_config" 'work-alias'
assert_not_contains "$personal_profiled_config" 'work-variant'

if invalid_options="$(render_custom_config work '[{"name":"invalid","options":{"nested":{"key":"value"}}}]' 2>&1)"; then
  echo "Nested mise options should fail template rendering" >&2
  exit 1
fi
assert_contains "$invalid_options" 'option "nested" must be a scalar'
if duplicate_options="$(render_custom_config work '[{"name":"invalid","options":{"version":"1"}}]' 2>&1)"; then
  echo "Duplicate mise options should fail template rendering" >&2
  exit 1
fi
assert_contains "$duplicate_options" 'option "version" duplicates a structured setting'

assert_contains "$mise_data" 'auto_upgrade: false'
assert_not_contains "$mise_data" 'automatic_upgrade_excludes:'
assert_contains "$mise_data" 'minimum_release_age: "0s"'
assert_not_contains "$mise_data" 'minimum_release_age_excludes:'

install_script="$(
  chezmoi execute-template < "$install_template"
)"
rendered_config_hash="$(
  printf '{{ includeTemplate "private_dot_config/mise/private_config.toml.tmpl" . | sha256sum }}\n' |
    chezmoi execute-template
)"
assert_contains "$install_script" "# mise config hash: $rendered_config_hash"
assert_contains "$install_script" "mise lock --global --platform \"\${mise_platform}\" --quiet >/dev/null"
assert_contains "$install_script" 'mise install --yes --quiet >/dev/null'
assert_not_contains "$install_script" 'mbx setup'
assert_contains "$install_script" 'mise reshim --quiet >/dev/null'

mkdir -p "$tmp_dir/bin"
cat > "$tmp_dir/bin/mise" <<'EOF'
#!/bin/bash
if [ "$1" = "--version" ]; then
  echo "2026.8.16 macos-arm64 (2026-08-31)"
  exit 0
fi
if [ "${GITHUB_TOKEN:-}" != "test-token" ]; then
  echo "mise did not receive GitHub authentication" >&2
  exit 1
fi
printf '%s\n' "$*" >> "${MISE_TEST_LOG}"
EOF
chmod +x "$tmp_dir/bin/mise"

cat > "$tmp_dir/bin/gh" <<'EOF'
#!/bin/bash
if [ "$*" = "auth token --hostname github.com" ]; then
  echo "test-token"
  exit 0
fi
exit 1
EOF
chmod +x "$tmp_dir/bin/gh"

printf '%s\n' "$install_script" > "$tmp_dir/install.sh"
GITHUB_TOKEN="" GH_TOKEN="" MISE_TEST_LOG="$tmp_dir/install.log" PATH="$tmp_dir/bin:$PATH" bash "$tmp_dir/install.sh"
expected_install_calls=$'lock --global --platform macos-arm64 --quiet\ninstall --yes --quiet\nreshim --quiet'
actual_install_calls="$(cat "$tmp_dir/install.log")"
if [ "$actual_install_calls" != "$expected_install_calls" ]; then
  echo "Unexpected mise install calls:" >&2
  echo "$actual_install_calls" >&2
  exit 1
fi

configuration_script="$(
  chezmoi execute-template < "$repo_root/root/run_once_after_01_configuration.sh.tmpl"
)"
assert_not_contains "$configuration_script" "mise install"

upgrade_template="$repo_root/root/run_after_01_mise_upgrade.sh.tmpl"
upgrade_script="$(chezmoi execute-template < "$upgrade_template")"
assert_contains "$upgrade_script" "chezmoi_command=\"\${CHEZMOI_COMMAND:-execute-template}\""
assert_contains "$upgrade_script" "if [ \"\${chezmoi_command}\" != \"update\" ]; then"
assert_contains "$upgrade_script" '--exclude "github:ogulcancelik/herdr"'
assert_contains "$upgrade_script" "mise upgrade \\"
assert_not_contains "$upgrade_script" '--minimum-release-age'
assert_contains "$upgrade_script" '>/dev/null'

printf '%s\n' "$upgrade_script" > "$tmp_dir/upgrade.sh"
GITHUB_TOKEN="" GH_TOKEN="" MISE_TEST_LOG="$tmp_dir/upgrade.log" PATH="$tmp_dir/bin:$PATH" CHEZMOI_COMMAND=apply bash "$tmp_dir/upgrade.sh"
if [ -e "$tmp_dir/upgrade.log" ]; then
  echo "mise upgrade ran during chezmoi apply" >&2
  exit 1
fi

GITHUB_TOKEN="" GH_TOKEN="" MISE_TEST_LOG="$tmp_dir/upgrade.log" PATH="$tmp_dir/bin:$PATH" CHEZMOI_COMMAND=update bash "$tmp_dir/upgrade.sh"
expected_upgrade_call='upgrade --yes --exclude github:ogulcancelik/herdr --quiet'
actual_upgrade_call="$(cat "$tmp_dir/upgrade.log")"
if [ "$actual_upgrade_call" != "$expected_upgrade_call" ]; then
  echo "Unexpected mise upgrade call:" >&2
  echo "$actual_upgrade_call" >&2
  exit 1
fi

apm_script="$(chezmoi execute-template < "$repo_root/root/run_after_03_apm_skills.sh.tmpl")"
printf '%s\n' "$apm_script" > "$tmp_dir/apm-install.sh"
bash -n "$tmp_dir/apm-install.sh"

mkdir -p "$tmp_dir/apm-bin"
cat > "$tmp_dir/apm-bin/mise" <<'EOF'
#!/bin/bash
case "$*" in
  "exec -- apm install --global --only=apm")
    if [ "${GITHUB_TOKEN:-}" != "test-apm-token" ]; then
      echo "APM did not receive GitHub authentication" >&2
      exit 1
    fi
    printf '%s\n' "$*" >> "${APM_TEST_LOG}"
    ;;
  "ls --installed --no-header npm:rosie-skills")
    if ! grep -q '^uninstall --yes --all npm:rosie-skills$' "${APM_TEST_LOG}" 2>/dev/null; then
      echo "npm:rosie-skills 0.8.5"
    fi
    ;;
  "uninstall --yes --all npm:rosie-skills")
    printf '%s\n' "$*" >> "${APM_TEST_LOG}"
    ;;
  *)
    echo "Unexpected mise invocation: $*" >&2
    exit 1
    ;;
esac
EOF
chmod +x "$tmp_dir/apm-bin/mise"

cat > "$tmp_dir/apm-bin/gh" <<'EOF'
#!/bin/bash
if [ "$*" = "auth token --hostname github.com" ]; then
  echo "test-apm-token"
  exit 0
fi
exit 1
EOF
chmod +x "$tmp_dir/apm-bin/gh"

apm_home="$tmp_dir/apm-home"
mkdir -p "$apm_home/.agents/skills" "$apm_home/.pi/skills"
printf '# rosie-lock v1\n' > "$apm_home/.agents/rosie.lock"
apm_skill_names=(
  agentic-progressive-disclosure-architecture
  azure-kusto
  crabbox
  create-pr
  find-skills
  git-commit
  gh-stack
  grill-me
  grilling
  handoff
  playwright-cli
  pretty-mermaid
  skill-creator
  tabctl
  splunk-log-analysis
)
for skill_name in "${apm_skill_names[@]}"; do
  skill_path="$apm_home/.agents/skills/$skill_name"
  if [ "$skill_name" = "splunk-log-analysis" ]; then
    work_skill="$apm_home/.local/share/agent-skills/github-ekroon/agent-skills/skills/owned/$skill_name"
    mkdir -p "$work_skill"
    ln -s "../../.local/share/agent-skills/github-ekroon/agent-skills/skills/owned/$skill_name" "$skill_path"
  else
    mkdir -p "$skill_path"
  fi
  ln -s "../../.agents/skills/$skill_name" "$apm_home/.pi/skills/$skill_name"
done
git -C "$apm_home/.local/share/agent-skills/github-ekroon" init -q

GITHUB_APM_PAT="" GITHUB_TOKEN="" \
  APM_TEST_LOG="$tmp_dir/apm-install.log" \
  HOME="$apm_home" PATH="$tmp_dir/apm-bin:$PATH" bash "$tmp_dir/apm-install.sh"
if [ ! -f "$apm_home/.local/state/dotfiles-agent-skills/apm-handoff-v1" ]; then
  echo "APM handoff marker was not created" >&2
  exit 1
fi
if [ -e "$apm_home/.local/share/agent-skills/github-ekroon" ]; then
  echo "Clean work skill checkout was not removed" >&2
  exit 1
fi
if [ -e "$apm_home/.agents/rosie.lock" ]; then
  echo "Rosie lockfile was not removed" >&2
  exit 1
fi
if ! grep -q '^uninstall --yes --all npm:rosie-skills$' "$tmp_dir/apm-install.log"; then
  echo "Installed Rosie tool was not uninstalled" >&2
  exit 1
fi
for skill_name in "${apm_skill_names[@]}"; do
  if [ -e "$apm_home/.agents/skills/$skill_name" ] || [ -L "$apm_home/.agents/skills/$skill_name" ]; then
    echo "Rosie skill was not removed before APM installation: $skill_name" >&2
    exit 1
  fi
  if [ -e "$apm_home/.pi/skills/$skill_name" ] || [ -L "$apm_home/.pi/skills/$skill_name" ]; then
    echo "Rosie Pi alias was not removed: $skill_name" >&2
    exit 1
  fi
done

mkdir -p "$apm_home/.agents/skills/user-skill"
GITHUB_APM_PAT="" GITHUB_TOKEN="" \
  APM_TEST_LOG="$tmp_dir/apm-install.log" \
  HOME="$apm_home" PATH="$tmp_dir/apm-bin:$PATH" bash "$tmp_dir/apm-install.sh"
if [ ! -d "$apm_home/.agents/skills/user-skill" ]; then
  echo "APM handoff removed files on a subsequent apply" >&2
  exit 1
fi
if [ "$(grep -c '^uninstall --yes --all npm:rosie-skills$' "$tmp_dir/apm-install.log")" -ne 1 ]; then
  echo "Rosie tool uninstall was repeated after the first apply" >&2
  exit 1
fi
