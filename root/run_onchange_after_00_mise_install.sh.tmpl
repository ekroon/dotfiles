#!/bin/bash
set -euo pipefail

# mise config hash: {{ includeTemplate "private_dot_config/mise/private_config.toml.tmpl" . | sha256sum }}
if ! command -v mise >/dev/null 2>&1; then
  echo "mise is required to install configured tools" >&2
  exit 1
fi

if [ -z "${GITHUB_TOKEN:-}" ]; then
  if [ -n "${GH_TOKEN:-}" ]; then
    export GITHUB_TOKEN="${GH_TOKEN}"
  elif command -v gh >/dev/null 2>&1; then
    if github_token="$(gh auth token --hostname github.com 2>/dev/null)"; then
      export GITHUB_TOKEN="${github_token}"
    fi
  fi
fi

mise_platform="$(mise --version 2>/dev/null | awk 'NR == 1 { print $2 }')"
if [ -z "${mise_platform}" ]; then
  echo "Could not determine the current mise platform" >&2
  exit 1
fi

mise lock --global --platform "${mise_platform}" --quiet >/dev/null
mise install --yes --quiet >/dev/null
