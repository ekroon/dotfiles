{{- $machine := get . "machine" | default dict -}}
{{- $profile := get $machine "profile" | default "" -}}
{{- if not (has $profile (list "work" "personal")) -}}
{{-   fail (printf "unsupported or missing machine profile %q" $profile) -}}
{{- end -}}
{{- $agentKit := .agent_kit -}}
name: erwin-agent-skills
version: 1.0.0
targets: [copilot]
executables:
  allow:
{{- range $pkg, $perms := $agentKit.allow_executables }}
    {{ $pkg | quote }}:
{{-   range $perm, $enabled := $perms }}
      {{ $perm }}: {{ $enabled }}
{{-   end }}
{{- end }}
{{- if eq $profile "work" }}
{{-   range $pkg, $perms := $agentKit.work.allow_executables }}
    {{ $pkg | quote }}:
{{-     range $perm, $enabled := $perms }}
      {{ $perm }}: {{ $enabled }}
{{-     end }}
{{-   end }}
{{- end }}
# Dependencies track their upstream default branches. `apm update -g` reviews
# ref changes and updates the per-machine lock; installs replay those pins.
dependencies:
  apm:
    - git: {{ $agentKit.repository | quote }}
      ref: {{ $agentKit.ref | quote }}
{{- if eq $profile "work" }}
    - git: {{ $agentKit.work.repository | quote }}
      path: {{ $agentKit.work.path | quote }}
      ref: {{ $agentKit.work.ref | quote }}
{{- end }}
