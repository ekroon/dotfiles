{{- $codespaces := env "CODESPACES" | not | not -}}
{{- $repo := env "GITHUB_REPOSITORY" | default "" -}}
{{- $dotcom := eq $repo "github/github" -}}
{{- $interactive := stdinIsATTY -}}
{{- $profileEnv := env "CHEZMOI_MACHINE_PROFILE" -}}
{{- $workHostHashes := list "21f25d8912ca333f98451441da3aa1488634d0ce12b99336829f149fd4e93222" -}}
{{- $workHost := has (sha256sum .chezmoi.hostname) $workHostHashes -}}
{{- $workCodespace := and $codespaces (hasPrefix "github/" $repo) -}}
{{- $profile := "" -}}
{{- if $profileEnv -}}
{{-   if not (has $profileEnv (list "work" "personal")) -}}
{{-     fail (printf "CHEZMOI_MACHINE_PROFILE must be exactly \"work\" or \"personal\", got %q" $profileEnv) -}}
{{-   end -}}
{{-   $profile = $profileEnv -}}
{{- else if or $workHost $workCodespace -}}
{{-   $profile = "work" -}}
{{- else if $interactive -}}
{{-   $profile = promptChoice "machine profile" (list "work" "personal") "work" -}}
{{- else -}}
{{-   fail "machine profile is not configured; run `chezmoi update --init` in a terminal, or set CHEZMOI_MACHINE_PROFILE for automation" -}}
{{- end -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

[diff]
    exclude = ["scripts"]

[data]
    name = "Erwin Kroon"
    codespaces = {{ $codespaces }}
    repo = {{ $repo | quote }}
    dotcom = {{ $dotcom }}
    {{- if $codespaces }}{{/* Codespaces always uses default email */}}
    email = "ekroon@github.com"
    {{- else if $interactive }}{{/* Interactive setup, so prompt for an email address */}}
    email = {{ promptString "email" | quote }}
    {{- else }}{{/* Non-interactive (devcontainer, CI, etc.), so set a default email */}}
    email = "ekroon@github.com"
    {{- end }}

[data.machine]
    profile = {{ $profile | quote }}
