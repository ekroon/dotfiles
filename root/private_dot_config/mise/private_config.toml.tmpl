{{- define "mise_plain_tool" -}}
{{- $environment := index . "environment" -}}
{{- $os := index . "os" -}}
{{- $repo := index . "repo" -}}
{{- $profile := index . "profile" -}}
{{- $distro_codename := index . "distro_codename" -}}
{{- $tool := index . "tool" -}}
{{- if kindIs "string" $tool }}
{{ $tool | quote }} = "latest"
{{- else if not (get $tool "variants") }}
{{- $matches := true -}}
{{- $filters := get $tool "filters" -}}
{{- if $filters }}
{{- $tool_os := get $filters "os" -}}
{{- if and $tool_os (not (has $os $tool_os)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_environments := get $filters "environment" -}}
{{- if and $tool_environments (not (has $environment $tool_environments)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_profiles := get $filters "profile" -}}
{{- if and $tool_profiles (not (has $profile $tool_profiles)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_distro_codenames := get $filters "distro_codename" -}}
{{- if and $tool_distro_codenames (not (has $distro_codename $tool_distro_codenames)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_not_distro_codenames := get $filters "not_distro_codename" -}}
{{- if and $tool_not_distro_codenames (has $distro_codename $tool_not_distro_codenames) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_repos := get $filters "repo" -}}
{{- if $tool_repos }}
{{- $repo_matched := false -}}
{{- range $tool_repos }}
{{- $pattern := . -}}
{{- if eq $pattern "*" -}}
{{- $repo_matched = true -}}
{{- else if hasSuffix "/*" $pattern -}}
{{- $repo_matched = or $repo_matched (hasPrefix (trimSuffix "*" $pattern) $repo) -}}
{{- else -}}
{{- $repo_matched = or $repo_matched (eq $pattern $repo) -}}
{{- end -}}
{{- end }}
{{- if not $repo_matched }}
{{- $matches = false -}}
{{- end }}
{{- end }}
{{- end }}
{{- if and $matches (not (or (get $tool "asset_pattern") (get $tool "bin") (get $tool "bin_path") (get $tool "minimum_release_age") (get $tool "options"))) }}
{{ get $tool "name" | quote }} = {{ default "latest" (get $tool "version") | quote }}
{{- end }}
{{- end }}
{{- end -}}
{{- define "mise_plain_tools" -}}
{{- $environment := index . "environment" -}}
{{- $os := index . "os" -}}
{{- $repo := index . "repo" -}}
{{- $profile := index . "profile" -}}
{{- $distro_codename := index . "distro_codename" -}}
{{- range index . "tools" }}
{{- if and (not (kindIs "string" .)) (get . "variants") }}
{{- $base := deepCopy . -}}
{{- $_ := unset $base "variants" -}}
{{- range get . "variants" }}
{{- template "mise_plain_tool" dict "tool" (mergeOverwrite (deepCopy $base) .) "environment" $environment "os" $os "repo" $repo "profile" $profile "distro_codename" $distro_codename }}
{{- end }}
{{- else }}
{{- template "mise_plain_tool" dict "tool" . "environment" $environment "os" $os "repo" $repo "profile" $profile "distro_codename" $distro_codename }}
{{- end }}
{{- end }}
{{- end -}}
{{- define "mise_alias" -}}
{{- $environment := index . "environment" -}}
{{- $os := index . "os" -}}
{{- $repo := index . "repo" -}}
{{- $profile := index . "profile" -}}
{{- $distro_codename := index . "distro_codename" -}}
{{- $tool := index . "tool" -}}
{{- if and (not (kindIs "string" $tool)) (not (get $tool "variants")) }}
{{- $matches := true -}}
{{- $filters := get $tool "filters" -}}
{{- if $filters }}
{{- $tool_os := get $filters "os" -}}
{{- if and $tool_os (not (has $os $tool_os)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_environments := get $filters "environment" -}}
{{- if and $tool_environments (not (has $environment $tool_environments)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_profiles := get $filters "profile" -}}
{{- if and $tool_profiles (not (has $profile $tool_profiles)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_distro_codenames := get $filters "distro_codename" -}}
{{- if and $tool_distro_codenames (not (has $distro_codename $tool_distro_codenames)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_not_distro_codenames := get $filters "not_distro_codename" -}}
{{- if and $tool_not_distro_codenames (has $distro_codename $tool_not_distro_codenames) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_repos := get $filters "repo" -}}
{{- if $tool_repos }}
{{- $repo_matched := false -}}
{{- range $tool_repos }}
{{- $pattern := . -}}
{{- if eq $pattern "*" -}}
{{- $repo_matched = true -}}
{{- else if hasSuffix "/*" $pattern -}}
{{- $repo_matched = or $repo_matched (hasPrefix (trimSuffix "*" $pattern) $repo) -}}
{{- else -}}
{{- $repo_matched = or $repo_matched (eq $pattern $repo) -}}
{{- end -}}
{{- end }}
{{- if not $repo_matched }}
{{- $matches = false -}}
{{- end }}
{{- end }}
{{- end }}
{{- if and $matches (get $tool "alias") }}
{{ get $tool "name" | quote }} = {{ get $tool "alias" | quote }}
{{- end }}
{{- end }}
{{- end -}}
{{- define "mise_aliases" -}}
{{- $environment := index . "environment" -}}
{{- $os := index . "os" -}}
{{- $repo := index . "repo" -}}
{{- $profile := index . "profile" -}}
{{- $distro_codename := index . "distro_codename" -}}
{{- range index . "tools" }}
{{- if and (not (kindIs "string" .)) (get . "variants") }}
{{- $base := deepCopy . -}}
{{- $_ := unset $base "variants" -}}
{{- range get . "variants" }}
{{- template "mise_alias" dict "tool" (mergeOverwrite (deepCopy $base) .) "environment" $environment "os" $os "repo" $repo "profile" $profile "distro_codename" $distro_codename }}
{{- end }}
{{- else }}
{{- template "mise_alias" dict "tool" . "environment" $environment "os" $os "repo" $repo "profile" $profile "distro_codename" $distro_codename }}
{{- end }}
{{- end }}
{{- end -}}
{{- define "mise_structured_tool" -}}
{{- $environment := index . "environment" -}}
{{- $os := index . "os" -}}
{{- $repo := index . "repo" -}}
{{- $profile := index . "profile" -}}
{{- $distro_codename := index . "distro_codename" -}}
{{- $tool := index . "tool" -}}
{{- if and (not (kindIs "string" $tool)) (not (get $tool "variants")) }}
{{- $matches := true -}}
{{- $asset_pattern := get $tool "asset_pattern" -}}
{{- $bin := get $tool "bin" -}}
{{- $bin_path := get $tool "bin_path" -}}
{{- $minimum_release_age := get $tool "minimum_release_age" -}}
{{- $options := get $tool "options" -}}
{{- $filters := get $tool "filters" -}}
{{- if $filters }}
{{- $tool_os := get $filters "os" -}}
{{- if and $tool_os (not (has $os $tool_os)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_environments := get $filters "environment" -}}
{{- if and $tool_environments (not (has $environment $tool_environments)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_profiles := get $filters "profile" -}}
{{- if and $tool_profiles (not (has $profile $tool_profiles)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_distro_codenames := get $filters "distro_codename" -}}
{{- if and $tool_distro_codenames (not (has $distro_codename $tool_distro_codenames)) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_not_distro_codenames := get $filters "not_distro_codename" -}}
{{- if and $tool_not_distro_codenames (has $distro_codename $tool_not_distro_codenames) }}
{{- $matches = false -}}
{{- end }}
{{- $tool_repos := get $filters "repo" -}}
{{- if $tool_repos }}
{{- $repo_matched := false -}}
{{- range $tool_repos }}
{{- $pattern := . -}}
{{- if eq $pattern "*" -}}
{{- $repo_matched = true -}}
{{- else if hasSuffix "/*" $pattern -}}
{{- $repo_matched = or $repo_matched (hasPrefix (trimSuffix "*" $pattern) $repo) -}}
{{- else -}}
{{- $repo_matched = or $repo_matched (eq $pattern $repo) -}}
{{- end -}}
{{- end }}
{{- if not $repo_matched }}
{{- $matches = false -}}
{{- end }}
{{- end }}
{{- end }}
{{- if and $matches (or $asset_pattern $bin $bin_path $minimum_release_age $options) }}

[tools.{{ get $tool "name" | quote }}]
version = {{ default "latest" (get $tool "version") | quote }}
{{- if $asset_pattern }}
asset_pattern = {{ $asset_pattern | quote }}
{{- end }}
{{- if $bin }}
bin = {{ $bin | quote }}
{{- end }}
{{- if $bin_path }}
bin_path = {{ $bin_path | quote }}
{{- end }}
{{- if $minimum_release_age }}
minimum_release_age = {{ $minimum_release_age | quote }}
{{- end }}
{{- if $options }}
{{- range $option, $value := $options }}
{{- if not (or (kindIs "string" $value) (kindIs "bool" $value) (kindIs "int" $value) (kindIs "float64" $value)) }}
{{- fail (printf "mise tool %q option %q must be a scalar" (get $tool "name") $option) }}
{{- end }}
{{- if has $option (list "version" "asset_pattern" "bin" "bin_path" "minimum_release_age") }}
{{- fail (printf "mise tool %q option %q duplicates a structured setting" (get $tool "name") $option) }}
{{- end }}
{{- end }}
{{ toToml $options | trim }}
{{- end }}
{{- end }}
{{- end }}
{{- end -}}
{{- define "mise_structured_tools" -}}
{{- $environment := index . "environment" -}}
{{- $os := index . "os" -}}
{{- $repo := index . "repo" -}}
{{- $profile := index . "profile" -}}
{{- $distro_codename := index . "distro_codename" -}}
{{- range index . "tools" }}
{{- if and (not (kindIs "string" .)) (get . "variants") }}
{{- $base := deepCopy . -}}
{{- $_ := unset $base "variants" -}}
{{- range get . "variants" }}
{{- template "mise_structured_tool" dict "tool" (mergeOverwrite (deepCopy $base) .) "environment" $environment "os" $os "repo" $repo "profile" $profile "distro_codename" $distro_codename }}
{{- end }}
{{- else }}
{{- template "mise_structured_tool" dict "tool" . "environment" $environment "os" $os "repo" $repo "profile" $profile "distro_codename" $distro_codename }}
{{- end }}
{{- end }}
{{- end -}}
{{- $environment := "local" -}}
{{- if .codespaces -}}
{{- $environment = "codespace" -}}
{{- else if eq (env "DEVCONTAINER") "true" -}}
{{- $environment = "devcontainer" -}}
{{- end -}}
{{- $distro_codename := env "MISE_DISTRO_CODENAME" -}}
{{- if and (not $distro_codename) (eq .chezmoi.os "linux") -}}
{{- $distro_codename = output "sh" "-c" "sed -n 's/^VERSION_CODENAME=//p' /etc/os-release 2>/dev/null | tr -d '\"' | head -n1" | trim -}}
{{- end -}}
{{- $profile := get (get . "machine" | default dict) "profile" | default "" -}}
min_version = "2026.8.16"

{{ toToml (dict "wrappers" .mise_wrappers) }}

[settings.github]
credential_command = 'gh auth token --hostname "$MISE_CREDENTIAL_HOST"'

[tool_alias]
{{ template "mise_aliases" dict "tools" .mise_tools "environment" $environment "os" .chezmoi.os "repo" .repo "profile" $profile "distro_codename" $distro_codename }}

[tools]
# === Filtered mise tools (from .chezmoidata.yaml) ===
{{ template "mise_plain_tools" dict "tools" .mise_tools "environment" $environment "os" .chezmoi.os "repo" .repo "profile" $profile "distro_codename" $distro_codename }}
{{ template "mise_structured_tools" dict "tools" .mise_tools "environment" $environment "os" .chezmoi.os "repo" .repo "profile" $profile "distro_codename" $distro_codename }}
[settings]
idiomatic_version_file_enable_tools = ["node", "rust"]
lockfile = true
minimum_release_age = {{ .mise_update_policy.minimum_release_age | quote }}

[settings.status]
missing_tools = "never"
